{
  "name": "angular-wprocesso-coop-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "npm run generate:full",
    "build": "ng build",
    "prewatch": "npm run generate:full",
    "watch": "ng build --watch",
    "generate:seguranca": "ng-openapi-gen --config projects/angular-wprocesso-coop-ui/src/lib/shared/services/seguranca/apidescriptor/ng-openapi-gen-seguranca.json && node scripts/ajustar-exportacoes-api.mjs",
    "generate:cadastro": "ng-openapi-gen --config projects/angular-wprocesso-coop-ui/src/lib/shared/services/cadastro/apidescriptor/ng-openapi-gen-cadastro.json && node scripts/ajustar-exportacoes-api.mjs",
    "generate:full": "npm run generate:seguranca && npm run generate:cadastro"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@primeuix/themes": "^2.0.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.52.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
